<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" styleClass="view-scroll"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.financetracker.controller.DashboardController">

  <VBox spacing="0" style="-fx-background-color:#F3F4F6;">

    <!-- ── Banner ──────────────────────────────────────────────────────────── -->
    <HBox alignment="CENTER_LEFT" spacing="0"
          style="-fx-background-color:linear-gradient(to right,#1D4ED8,#2563EB,#4F46E5);
                 -fx-padding:28 32 28 32;
                 -fx-effect:dropshadow(gaussian,rgba(37,99,235,0.45),16,0,0,6);">
      <VBox spacing="4" HBox.hgrow="ALWAYS">
        <Label fx:id="bannerGreeting" text="God dag"
               style="-fx-font-size:26px;-fx-font-weight:bold;-fx-text-fill:white;"/>
        <Label fx:id="bannerSubtitle" text="Her er din økonomi-oversikt"
               style="-fx-font-size:13px;-fx-text-fill:rgba(255,255,255,0.72);"/>
      </VBox>
      <Label fx:id="bannerDate" text="April 2026"
             style="-fx-font-size:14px;-fx-font-weight:bold;-fx-text-fill:rgba(255,255,255,0.9);
                    -fx-background-color:rgba(255,255,255,0.15);
                    -fx-background-radius:8;-fx-padding:8 16 8 16;
                    -fx-border-color:rgba(255,255,255,0.25);-fx-border-radius:8;-fx-border-width:1;"/>
    </HBox>

    <!-- ── Metric Cards ────────────────────────────────────────────────────── -->
    <HBox spacing="16" style="-fx-padding:24 32 0 32;">

      <!-- Balance – blå -->
      <VBox HBox.hgrow="ALWAYS" spacing="10"
            style="-fx-background-color:linear-gradient(to bottom right,#1E3A8A,#2563EB);
                   -fx-background-radius:16;-fx-padding:22;
                   -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.22),16,0,0,6);">
        <Label text="TOTAL SALDO"
               style="-fx-font-size:10px;-fx-font-weight:bold;-fx-text-fill:rgba(255,255,255,0.65);"/>
        <Label fx:id="labelBalance" text="kr 0,00"
               style="-fx-font-size:24px;-fx-font-weight:bold;-fx-text-fill:white;"/>
        <Label fx:id="labelBalanceChange" text=" "
               style="-fx-font-size:11px;-fx-text-fill:rgba(255,255,255,0.7);"/>
      </VBox>

      <!-- Inntekt – grønn -->
      <VBox HBox.hgrow="ALWAYS" spacing="10"
            style="-fx-background-color:linear-gradient(to bottom right,#064E3B,#059669);
                   -fx-background-radius:16;-fx-padding:22;
                   -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.22),16,0,0,6);">
        <Label text="INNTEKT DENNE MÅNEDEN"
               style="-fx-font-size:10px;-fx-font-weight:bold;-fx-text-fill:rgba(255,255,255,0.65);"/>
        <Label fx:id="labelIncome" text="kr 0,00"
               style="-fx-font-size:24px;-fx-font-weight:bold;-fx-text-fill:white;"/>
        <Label fx:id="labelIncomeChange" text=" "
               style="-fx-font-size:11px;-fx-text-fill:rgba(255,255,255,0.7);"/>
      </VBox>

      <!-- Utgifter – rød -->
      <VBox HBox.hgrow="ALWAYS" spacing="10"
            style="-fx-background-color:linear-gradient(to bottom right,#7F1D1D,#DC2626);
                   -fx-background-radius:16;-fx-padding:22;
                   -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.22),16,0,0,6);">
        <Label text="UTGIFTER DENNE MÅNEDEN"
               style="-fx-font-size:10px;-fx-font-weight:bold;-fx-text-fill:rgba(255,255,255,0.65);"/>
        <Label fx:id="labelExpenses" text="kr 0,00"
               style="-fx-font-size:24px;-fx-font-weight:bold;-fx-text-fill:white;"/>
        <Label fx:id="labelExpensesChange" text=" "
               style="-fx-font-size:11px;-fx-text-fill:rgba(255,255,255,0.7);"/>
      </VBox>

      <!-- Sparerate – lilla -->
      <VBox HBox.hgrow="ALWAYS" spacing="10"
            style="-fx-background-color:linear-gradient(to bottom right,#3B0764,#7C3AED);
                   -fx-background-radius:16;-fx-padding:22;
                   -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.22),16,0,0,6);">
        <Label text="SPARERATE DENNE MÅNEDEN"
               style="-fx-font-size:10px;-fx-font-weight:bold;-fx-text-fill:rgba(255,255,255,0.65);"/>
        <Label fx:id="labelSavingsRate" text="0 pst"
               style="-fx-font-size:24px;-fx-font-weight:bold;-fx-text-fill:white;"/>
        <Label fx:id="labelSavingsAmount" text=" "
               style="-fx-font-size:11px;-fx-text-fill:rgba(255,255,255,0.7);"/>
      </VBox>

    </HBox>

    <!-- ── Charts Row ──────────────────────────────────────────────────────── -->
    <HBox spacing="16" style="-fx-padding:20 32 0 32;">

      <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="6">
        <Label text="Inntekt vs Utgifter – siste 6 måneder" styleClass="card-title"/>
        <BarChart fx:id="barChart" prefHeight="255" animated="false"
                  barGap="3" categoryGap="16">
          <xAxis><CategoryAxis fx:id="barChartXAxis"/></xAxis>
          <yAxis><NumberAxis fx:id="barChartYAxis"/></yAxis>
        </BarChart>
      </VBox>

      <VBox styleClass="card" prefWidth="310" spacing="6">
        <Label text="Utgifter per kategori" styleClass="card-title"/>
        <PieChart fx:id="pieChart" prefHeight="255" animated="false"
                  labelsVisible="false"/>
      </VBox>

    </HBox>

    <!-- ── Bottom Row ──────────────────────────────────────────────────────── -->
    <HBox spacing="16" style="-fx-padding:20 32 28 32;">

      <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="6">
        <Label text="Siste transaksjoner" styleClass="card-title"/>
        <HBox style="-fx-padding:2 0 2 0;">
          <Label text="Navn / Kategori" styleClass="section-title" HBox.hgrow="ALWAYS"/>
          <Label text="Dato"  styleClass="section-title" minWidth="90"/>
          <Label text="Beløp" styleClass="section-title" minWidth="115"
                 style="-fx-alignment:CENTER-RIGHT;"/>
        </HBox>
        <VBox fx:id="recentTxList" spacing="0"/>
      </VBox>

      <VBox styleClass="card" prefWidth="460" spacing="6">
        <Label text="Månedlig oversikt – siste 6 måneder" styleClass="card-title"/>
        <HBox style="-fx-padding:2 0 2 0;">
          <Label text="Måned"    styleClass="section-title" minWidth="90"/>
          <Region HBox.hgrow="ALWAYS"/>
          <Label text="Inntekt"  styleClass="section-title" minWidth="110"
                 style="-fx-alignment:CENTER-RIGHT;"/>
          <Label text="Utgifter" styleClass="section-title" minWidth="110"
                 style="-fx-alignment:CENTER-RIGHT;"/>
          <Label text="Spart"    styleClass="section-title" minWidth="100"
                 style="-fx-alignment:CENTER-RIGHT;"/>
        </HBox>
        <VBox fx:id="monthlyOverviewList" spacing="0"/>
      </VBox>

    </HBox>

  </VBox>
</ScrollPane>
